# Build/deploy settings for the CI pipeline (no secrets). Copy with the folder,
# then add the folder name to APP_DIR in .gitlab-ci.yml.
APP_VERSION=1.0.0
EAR_FILE=MyApp_1.0.0.ear
IMAGE_NAME=my-app
# plain, or ems if any module (including shared ones) uses JMS
BASE_FLAVOR=plain
PROFILE=UAT
RELEASE=my-app-bwce
PROFILE_SECRET=my-app-profile
