# Files that run inside Linux containers must keep LF endings, even when the
# repo is checked out on Windows with core.autocrlf=true. A CRLF shell script
# fails at container start with "/bin/bash^M: bad interpreter".
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.tpl           text eol=lf
*.txt           text eol=lf
*.xsl           text eol=lf
*.env           text eol=lf

# Binary TIBCO artefacts
*.ear           binary
*.zip           binary
*.jar           binary
